<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\common.props" />

  <!-- Unit tests for the host's own code (the auth server's impersonation pieces: ticket protector, claims handler,
       Impersonate page, cookie refresh), every port a fake; plus HostIntegration/: the real host on a TestServer against
       PostgreSQL databases of its own (HostIntegrationFixture), for the round trips the risk matrix requires. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>OpenTms</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.7" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenTms.HttpApi.Host\OpenTms.HttpApi.Host.csproj" />
  </ItemGroup>

  <!-- The one world builder of the transport tests and the EF command capture, compiled in here as well: the AI connector tests
       build their tenants' data through the real services of the real host (AiConnector/). -->
  <ItemGroup>
    <Compile Include="..\OpenTms.EntityFrameworkCore.Tests\TransportRun\TransportRunFixture.cs" Link="AiConnector\Linked\TransportRunFixture.cs" />
    <Compile Include="..\OpenTms.EntityFrameworkCore.Tests\EntityFrameworkCore\EfCommandCapture.cs" Link="AiConnector\Linked\EfCommandCapture.cs" />
  </ItemGroup>

</Project>
