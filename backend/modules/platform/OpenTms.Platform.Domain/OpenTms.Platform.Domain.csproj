<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenTms.Platform</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Ddd.Domain" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Features" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Identity.Domain" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.TenantManagement.Domain" Version="10.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real NL/BE/DE addresses for "Reset to dataset" (docs/designs/65-tenant-test-datasets.md). -->
    <EmbeddedResource Include="TestData\Addresses\addresses.csv.gz" LogicalName="OpenTms.Platform.TestData.addresses.csv.gz" Condition="Exists('TestData\Addresses\addresses.csv.gz')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenTms.Platform.Domain.Shared\OpenTms.Platform.Domain.Shared.csproj" />
  </ItemGroup>

</Project>
