    <ProjectReference Include="..\..\modules\integrations\OpenTms.Integrations.Domain.Shared\OpenTms.Integrations.Domain.Shared.csproj" />
    <ProjectReference Include="..\..\modules\reporting\OpenTms.Reporting.Domain.Shared\OpenTms.Reporting.Domain.Shared.csproj" />
