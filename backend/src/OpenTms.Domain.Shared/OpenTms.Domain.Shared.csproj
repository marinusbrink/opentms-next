    <PackageReference Include="Volo.Abp.OpenIddict.Domain.Shared" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.Identity.Domain.Shared" Version="10.6.0" />
    <PackageReference Include="Volo.Abp.TenantManagement.Domain.Shared" Version="10.6.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\OpenTms\*.json" />
