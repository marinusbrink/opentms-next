{
  "App": {
    "SelfUrl": "https://localhost:44301",
    "CorsOrigins": "http://localhost:5173",
    "RedirectAllowedUrls": "http://localhost:5173",
    "DisablePII": false,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
              }
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=OpenTms;Username=postgres;Password=postgres"
  },
  "Tenancy": {
    "Database": {
      "Host": null,
      "Port": null
    },
    "ConnectionPool": {
      "MinimumPoolSize": 0,
      "MaximumPoolSize": 10,
      "ConnectionIdleLifetime": 60,
      "ConnectionPruningInterval": 10
    },
    "Provisioning": {
      "ConnectionString": null,
      "AllowHostLogin": false
    }
  },
  "Outbox": {
    "DispatchEnabled": true,
    "SweepPeriod": "00:05:00",
    "BatchSize": 100
  },
  "InstanceRegistry": {
    "Enabled": true,
    "Role": "Api",
    "HeartbeatPeriod": "00:00:30",
    "UnresponsiveAfter": "00:01:30",
    "Retention": "7.00:00:00"
  },
  "AuthServer": {
    "Authority": "https://localhost:44301",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "OpenTms_Swagger",
    "CertificatePassPhrase": "134b6dab-9454-4fb3-bd4c-5aa7aaf342d8"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "tAbtDtydW7qdDgSZ"
  },
  "AddressLookup": {
    "PdokBaseUrl": "https://api.pdok.nl/bzk/locatieserver/search/v3_1/free",
    "NominatimEnabled": true,
    "NominatimBaseUrl": "https://nominatim.openstreetmap.org/search",
    "UserAgent": "OpenTMS/1.0 (address lookup)",
    "TimeoutSeconds": 5,
    "CacheDays": 30
  },
  "Integrations": {
    "PdfGeneratorApi": {
      "BaseUrl": "https://us1.pdfgeneratorapi.com/api/v4/",
      "DefaultWorkspace": "default-workspace@opentms.nl",
      "TenantWorkspace": "workspace-tenant-{0}@opentms.nl"
    }
  }
}
