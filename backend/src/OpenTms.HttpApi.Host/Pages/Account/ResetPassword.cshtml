@page
@using Microsoft.Extensions.Localization
@using OpenTms.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Theming
@using Volo.Abp.Identity
@model OpenTms.Pages.Account.OpenTmsResetPasswordModel
@inject IStringLocalizer<OpenTmsResource> T
@inject IThemeManager ThemeManager
@* Choosing a password through a one-time link (docs/designs/62-sign-in-tenant-detection.md, "Password recovery"). *@

@{
    Layout = ThemeManager.CurrentTheme.GetAccountLayout();
}

<div>
    @if (Model.InvalidLink)
    {
        <h1 class="ots-title">@T["SignIn:LinkInvalidTitle"]</h1>
        <p class="mt-3">@T["SignIn:LinkInvalidText"]</p>
        <div class="d-grid gap-2 mt-4">
            <a class="btn btn-primary btn-lg" href="@Url.Page("./ForgotPassword")">@T["SignIn:RequestNewLink"]</a>
        </div>
    }
    else
    {
        <h1 class="ots-title">@T["SignIn:NewPasswordTitle"]</h1>
        <p class="text-muted mt-3">@(Model.Change ? T["SignIn:NewPasswordRequiredFirst"] : T["SignIn:NewPasswordText"])</p>
        <div class="ots-account">
            <span class="ots-account-email" title="@Model.AccountEmail">@Model.AccountEmail</span>
        </div>
        <form method="post" class="mt-4" novalidate>
            @* The link (user, tenant, token) is in the page's sealed cookie, never in the form. For password managers: the account this password belongs to. *@
            <input type="email" name="AccountEmail" value="@Model.AccountEmail" autocomplete="username" class="d-none" readonly tabindex="-1" aria-hidden="true" />
            <div class="mb-3">
                <label for="Password" class="form-label">@T["SignIn:NewPasswordLabel"]</label>
                <input type="password" id="Password" name="Password" class="form-control" autocomplete="new-password"
                       maxlength="@IdentityUserConsts.MaxPasswordLength" autofocus />
            </div>
            <div class="mb-4">
                <label for="ConfirmPassword" class="form-label">@T["SignIn:ConfirmPasswordLabel"]</label>
                <input type="password" id="ConfirmPassword" name="ConfirmPassword" class="form-control" autocomplete="new-password"
                       maxlength="@IdentityUserConsts.MaxPasswordLength" />
            </div>
            <div class="d-grid gap-2">
                <abp-button type="submit" button-type="Primary" class="btn-lg">@T["SignIn:SavePassword"]</abp-button>
            </div>
        </form>
    }
</div>
