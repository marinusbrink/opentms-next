@page
@using Microsoft.Extensions.Localization
@using OpenTms.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Theming
@model OpenTms.Pages.Account.OpenTmsResetPasswordConfirmationModel
@inject IStringLocalizer<OpenTmsResource> T
@inject IThemeManager ThemeManager

@{
    Layout = ThemeManager.CurrentTheme.GetAccountLayout();
}

<div>
    <h1 class="ots-title">@T["SignIn:PasswordSetTitle"]</h1>
    <p class="mt-3">@T["SignIn:PasswordSetText"]</p>
    <div class="d-grid gap-2 mt-4">
        <a id="ContinueLink" class="btn btn-primary btn-lg" href="@Model.ContinueUrl">@(Model.BackToSignIn ? T["SignIn:SignIn"] : T["SignIn:GoToOpenTms"])</a>
    </div>
</div>
