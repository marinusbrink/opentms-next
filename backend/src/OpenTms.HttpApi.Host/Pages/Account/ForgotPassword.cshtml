@page
@using Microsoft.Extensions.Localization
@using OpenTms.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Theming
@using Volo.Abp.Identity
@model OpenTms.Pages.Account.OpenTmsForgotPasswordModel
@inject IStringLocalizer<OpenTmsResource> T
@inject IThemeManager ThemeManager
@* "Forgot password?" for every account of the address (docs/designs/62-sign-in-tenant-detection.md, "Password recovery"). *@

@{
    Layout = ThemeManager.CurrentTheme.GetAccountLayout();
}

<div>
    <h1 class="ots-title">@T["SignIn:ForgotTitle"]</h1>
    <p class="text-muted mt-3">@T["SignIn:ForgotText"]</p>
    <form method="post" class="mt-4" novalidate>
        <input type="hidden" asp-for="ReturnUrl" />
        <input type="hidden" asp-for="ReturnUrlHash" />
        <div class="mb-4">
            <label for="Email" class="form-label">@T["SignIn:EmailLabel"]</label>
            <input type="email" id="Email" name="Email" value="@Model.Email" class="form-control"
                   autocomplete="username email" maxlength="@IdentityUserConsts.MaxEmailLength" autofocus />
        </div>
        <div class="d-grid gap-2">
            <abp-button type="submit" button-type="Primary" class="btn-lg">@T["SignIn:ForgotSubmit"]</abp-button>
        </div>
    </form>
    <div class="mt-4">
        <a href="@Url.Page("./Login", new { returnUrl = Model.ReturnUrl, returnUrlHash = Model.ReturnUrlHash })" class="small">@T["SignIn:BackToSignIn"]</a>
    </div>
</div>
