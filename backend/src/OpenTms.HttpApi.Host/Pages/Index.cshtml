@page
@model OpenTms.Pages.IndexModel
@{
    Layout = null;
}
@* The backend's root opens Swagger UI at once (OpenTms.Pages.IndexModel). A 200 with an immediate refresh rather than
   a 302: the dev tooling that waits for this URL to be ready accepts only a page, and a redirect left it "starting". *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="refresh" content="0; url=@Model.SwaggerUrl">
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml">
    <title>OpenTMS NEXT API</title>
</head>
<body>
    <a href="@Model.SwaggerUrl">Swagger UI</a>
</body>
</html>
