{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@fullcalendar/*"],
            "message": "Design 66/70: feature code never imports FullCalendar; use components/ui/resource-scheduler (or its lazy wrapper and model)."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/components/ui/resource-scheduler.tsx"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
